{
  "name": "gemstone-org-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --grep-invert @a11y",
    "release:inspect": "node scripts/release-checklist.mjs --inspect-static-export",
    "validate:release": "node scripts/release-checklist.mjs"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.54.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
