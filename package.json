{
  "name": "gemstone-org-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --grep-invert @a11y",
    "release:inspect": "node scripts/release-checklist.mjs --inspect-static-export",
    "validate:release": "node scripts/release-checklist.mjs"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
